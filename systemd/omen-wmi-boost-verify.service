[Unit]
Description=Verify HP OMEN GPU power boost (omen_wmi_boost)
Documentation=file:/usr/share/doc/omen-wmi-boost/BOOT-SETUP.md
After=systemd-modules-load.service nvidia-powerd.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/omen-wmi-boost-verify

[Install]
WantedBy=multi-user.target
