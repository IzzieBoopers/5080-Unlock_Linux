# SPDX-License-Identifier: MIT
# HP OMEN AI-workload cooling profile.
# Copy to /etc/omen-wmi-fan-control.conf and restart the fan service.

fan_curve=32:5,45:50,70:50,76:70,82:100
target_temp_c=70

active_temp_c=45
idle_temp_c=35
active_util_percent=5
active_clock_mhz=500
active_fan_floor=50
active_hold_multiplier=3

workload_util_percent=30
workload_power_w=45
workload_clock_mhz=1000
soak_after_s=120
soak_step_s=120
soak_step_percent=5
soak_max_bias_percent=25
soak_gap_hold_s=90
soak_decay_s=600

warning_temp_c=80
warning_fan_percent=90
unlock_disable_temp_c=85
critical_samples=2
warning_repeat_s=300

ramp_up_step=20
ramp_down_step=1
ramp_down_dwell_s=12
temp_ema_alpha_percent=50
