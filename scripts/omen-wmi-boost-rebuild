#!/usr/bin/bash
# Rebuild omen_wmi_boost.ko for a specific kernel version.
set -euo pipefail

SRCDIR=/usr/src/omen_wmi_boost
TAG=omen-wmi-boost

usage() {
	echo "Usage: $0 <kernel-version>" >&2
	exit 1
}

[[ $# -ge 1 ]] || usage
KVER="$1"

KDIR="/lib/modules/${KVER}/build"
if [[ ! -d "$KDIR" ]]; then
	logger -t "$TAG" -p user.err "omen_wmi_boost: no headers for kernel ${KVER}"
	mkdir -p /var/lib/omen_wmi_boost
	touch /var/lib/omen_wmi_boost/rebuild-needed
	exit 1
fi

if [[ ! -f "${SRCDIR}/omen_wmi_boost.c" ]]; then
	logger -t "$TAG" -p user.err "omen_wmi_boost: source missing at ${SRCDIR}"
	touch /var/lib/omen_wmi_boost/rebuild-needed
	exit 1
fi

logger -t "$TAG" -p user.info "Rebuilding omen_wmi_boost for kernel ${KVER}"

make -C "$KDIR" M="$SRCDIR" clean 2>/dev/null || true
make -C "$KDIR" M="$SRCDIR" modules
make -C "$KDIR" M="$SRCDIR" modules_install

depmod -a "$KVER"
rm -f /var/lib/omen_wmi_boost/rebuild-needed
logger -t "$TAG" -p user.info "omen_wmi_boost installed for kernel ${KVER}"
