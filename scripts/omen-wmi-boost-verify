#!/usr/bin/bash
# SPDX-License-Identifier: MIT
# Post-boot check: module loaded and GPU boost flags active.
set -euo pipefail

TAG=omen-wmi-boost
SYSFS=/sys/kernel/omen_wmi_boost/gpu_state
PERFORMANCE=/sys/kernel/omen_wmi_boost/performance
LAST_ERROR=/sys/kernel/omen_wmi_boost/last_error
FAIL_FLAG=/run/omen_wmi_boost.failed
REBUILD_FLAG=/var/lib/omen_wmi_boost/rebuild-needed
REBUILD_SCRIPT=/usr/local/sbin/omen-wmi-boost-rebuild
NOTIFIER=/usr/local/sbin/omen-wmi-notify
KVER=$(uname -r)
MAX_ATTEMPTS=20
RETRY_SECS=2
REAPPLY_ON_ATTEMPTS=(5 10 15)

fail() {
	local reason="$1"
	local msg="omen_wmi_boost failed: ${reason}"

	logger -t "$TAG" -p user.err "$msg"
	printf '%s\n%s\n' "$(date -Iseconds)" "$reason" >"$FAIL_FLAG"

	if [[ -f "$REBUILD_FLAG" ]]; then
		msg="${msg}. Install matching kernel-devel, then restart this service."
	fi

	if [[ -x "$NOTIFIER" ]]; then
		"$NOTIFIER" "GPU power boost failed" \
			"${msg} See: journalctl -t ${TAG} -b" || true
	fi
	exit 1
}

pass() {
	rm -f "$FAIL_FLAG"
	exit 0
}

boost_active() {
	local state ctgp dtgp

	[[ -r "$SYSFS" ]] || return 1
	read -r state <"$SYSFS" || return 1
	ctgp=$(sed -n 's/.*ctgp=\([0-9]*\).*/\1/p' <<<"$state")
	dtgp=$(sed -n 's/.*dtgp=\([0-9]*\).*/\1/p' <<<"$state")
	[[ "$ctgp" == "1" && "$dtgp" == "1" ]]
}

reapply_performance() {
	if [[ ! -w "$PERFORMANCE" ]]; then
		return 0
	fi

	logger -t "$TAG" -p user.info "re-applying performance path"
	echo 1 >"$PERFORMANCE"
}

should_reapply() {
	local attempt="$1"
	local marker

	for marker in "${REAPPLY_ON_ATTEMPTS[@]}"; do
		[[ "$attempt" -eq "$marker" ]] && return 0
	done
	return 1
}

ensure_module_loaded() {
	if [[ -d /sys/module/omen_wmi_boost ]]; then
		return 0
	fi

	if ! modinfo -k "$KVER" omen_wmi_boost >/dev/null 2>&1; then
		if [[ ! -x "$REBUILD_SCRIPT" || ! -d "/lib/modules/${KVER}/build" ]]; then
			return 1
		fi

		logger -t "$TAG" -p user.info \
			"module missing for running kernel ${KVER}; rebuilding now"
		if ! "$REBUILD_SCRIPT" "$KVER"; then
			return 1
		fi
	fi

	modprobe omen_wmi_boost
}

if ! ensure_module_loaded; then
	reason="kernel module not loaded"
	if [[ -f "$REBUILD_FLAG" ]]; then
		reason="${reason} (rebuild required after kernel update)"
	elif ! modinfo -k "$KVER" omen_wmi_boost >/dev/null 2>&1; then
		reason="${reason} (no .ko for kernel ${KVER}; run: sudo ./install.sh)"
	fi
	fail "$reason"
fi

if [[ ! -r "$SYSFS" ]]; then
	fail "sysfs $SYSFS missing"
fi

for ((attempt = 1; attempt <= MAX_ATTEMPTS; attempt++)); do
	if boost_active; then
		if [[ "$attempt" -gt 1 ]]; then
			logger -t "$TAG" -p user.info "boost active after attempt ${attempt}"
		fi
		pass
	fi

	if should_reapply "$attempt"; then
		reapply_performance
	fi

	if [[ "$attempt" -lt "$MAX_ATTEMPTS" ]]; then
		sleep "$RETRY_SECS"
	fi
done

read -r state <"$SYSFS" || fail "cannot read gpu_state"
err_detail="gpu_state=${state}"
if [[ -r "$LAST_ERROR" ]]; then
	err_detail="${err_detail}; last_error=$(tr -d '\n' <"$LAST_ERROR")"
fi
fail "boost not active after ${MAX_ATTEMPTS} attempts (${err_detail})"
